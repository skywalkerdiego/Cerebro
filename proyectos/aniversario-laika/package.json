{
  "name": "aniversario-laika",
  "version": "1.0.0",
  "private": true,
  "description": "Dos años, hechos a mano — corto de aniversario estilo stop-motion Laika, montado en Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Aniversario out/aniversario.mp4 --codec h264 --crf 16",
    "still": "remotion still Aniversario out/still.png --frame",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
